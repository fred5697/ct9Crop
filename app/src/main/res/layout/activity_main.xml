<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:padding="12dp"
        android:translationY="100px"
        android:text="Align 3x3 grid in frame"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/rgbLiveText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#DD000000"
        android:padding="8dp"
        android:layout_marginTop="38dp"
        android:text="RGB: ---"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/frameOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/captureButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="CAPTURE"
        android:textSize="20sp"
        android:paddingHorizontal="48dp"
        android:paddingVertical="20dp"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/modeButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/exposureLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/flipModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLIP MODE"
            android:textSize="14sp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/noFlipModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO-FLIP MODE"
            android:textSize="14sp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/exposureLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/captureButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/exposureValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exposure: 0"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <SeekBar
            android:id="@+id/exposureSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="10"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
