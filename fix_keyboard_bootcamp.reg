Windows Registry Editor Version 5.00

; Fix keyboard issues for Android Studio on MacBook Bootcamp
; This disables problematic Windows IME features that conflict with JetBrains IDEs

[HKEY_CURRENT_USER\Control Panel\Input Method]
"EnableIndicator"="0"

[HKEY_CURRENT_USER\Keyboard Layout\Toggle]
"Language Hotkey"="3"
"Layout Hotkey"="3"

[HKEY_CURRENT_USER\Software\Microsoft\Input\Settings]
"EnableHwkbTextPrediction"=dword:00000000
"EnableHwkbAutocorrection"=dword:00000000
"EnableHwkbSuggestions"=dword:00000000

